[configuration]

entry_symbol = "spout_library_init"
compatibility_minimum = "4.2"
reloadable = false

[libraries]

windows.debug.x86_32 = "res://addons/godot-spout/bin/libgodot-spout.windows.debug.x86_32.dll"
windows.release.x86_32 = "res://addons/godot-spout/bin/libgodot-spout.windows.release.x86_32.dll"
windows.debug.x86_64 = "res://addons/godot-spout/bin/libgodot-spout.windows.debug.x86_64.dll"
windows.release.x86_64 = "res://addons/godot-spout/bin/libgodot-spout.windows.release.x86_64.dll"
